# Build context allowlist. Credentials, local state and downloaded models never enter an image.
*
!.dockerignore
!pyproject.toml
!README.md
!LICENSE
!main.py
!alembic.ini
!src/
!src/**
!alembic/
!alembic/**
!data/
!data/knowledge/
!data/knowledge/**
!requirements/
!requirements/linux-base.lock
!requirements/linux-dev.lock
!deploy/
!deploy/Dockerfile.api
!deploy/Dockerfile.web
!deploy/nginx.conf
!deploy/compose.full.yaml
!tests/
!tests/**
!evals/
!evals/datasets/
!evals/datasets/**
!scripts/
!scripts/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/node_modules/
**/dist/
**/.env*
**/*.log
**/*.key
**/*.pem
