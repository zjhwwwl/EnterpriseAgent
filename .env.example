# Phase 2: copy to .env; never commit .env or actual local secrets.
EA_APP_ENV=development
EA_HOST=127.0.0.1
EA_PORT=8000
EA_LOG_LEVEL=INFO
EA_DOCS_ENABLED=true
EA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
EA_DATA_DIR=var

# Application runtime: a restricted, non-owner PostgreSQL account.
# Use postgresql+psycopg://USER:PASSWORD@127.0.0.1:55432/enterprise_agent
# Keep real URLs out of docs, source, command arguments and screenshots.
EA_DATABASE_URL=

# Migration / seeding only: initialization account, never the API account.
EA_MIGRATION_DATABASE_URL=

# Separate test database and roles, never point at the demonstration database.
EA_TEST_DATABASE_URL=
EA_TEST_MIGRATION_DATABASE_URL=

# Optional Redis. When configured, login requires this rate limiter to work.
# Local Compose Redis binds to 127.0.0.1:56379; local-only, no Redis AUTH.
EA_REDIS_URL=
EA_LOGIN_MAX_ATTEMPTS=10
EA_LOGIN_WINDOW_SECONDS=60

# Required when EA_DATABASE_URL is configured; generate at least 32 characters.
# scripts/init-infra.ps1 creates random local secrets without overwriting files.
EA_JWT_SECRET=
EA_JWT_EXPIRE_MINUTES=30

# Public fictional demo password, not a real credential. Used only by seed.
EA_DEMO_PASSWORD=DemoOnly!2026

# Reserved for Agent phases. Phase 2 does not invoke an LLM.
EA_LLM_ENABLED=false
EA_DEEPSEEK_BASE_URL=https://api.deepseek.com
EA_DEEPSEEK_API_KEY=
