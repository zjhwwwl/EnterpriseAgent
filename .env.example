# Phase 6: copy to .env; never commit .env or actual local secrets.
EA_APP_ENV=development
EA_HOST=127.0.0.1
EA_PORT=8000
EA_LOG_LEVEL=INFO
EA_DOCS_ENABLED=true
EA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
EA_DATA_DIR=var

# Runtime account must be restricted and non-owner; scheme postgresql+psycopg.
# Real password-bearing URLs belong to ignored local configuration only.
EA_DATABASE_URL=
# Initialization account, used only by migration and seed commands.
EA_MIGRATION_DATABASE_URL=
# A separate dedicated test database, never the demo or another business database.
EA_TEST_DATABASE_URL=
EA_TEST_MIGRATION_DATABASE_URL=

# Dedicated aggregate-reader credentials, never the ordinary/owner account.
# init-infra.ps1 creates ignored secrets; init-analytics.ps1 initializes roles.
# run.ps1 enables analytics explicitly after initialization and migration.
EA_ANALYTICS_ENABLED=false
EA_ANALYTICS_DATABASE_URL=
EA_TEST_ANALYTICS_DATABASE_URL=
# Query timeout 100..10000 ms, row limit 1..500, SQL budget 128..16000 chars.
# The HTTP/Agent SQLPlan input itself is limited to 8000 characters.
EA_ANALYTICS_STATEMENT_TIMEOUT_MS=5000
EA_ANALYTICS_MAX_ROWS=100
EA_ANALYTICS_MAX_SQL_CHARS=8000

# Optional Redis; if configured, login requires the rate limiter to work.
# Local Compose endpoint: 127.0.0.1:56379, loopback only, no Redis AUTH.
EA_REDIS_URL=
EA_LOGIN_MAX_ATTEMPTS=10
EA_LOGIN_WINDOW_SECONDS=60

# Required with a business database; at least 32 random characters.
# init-infra.ps1 creates local secrets without overwriting existing files.
EA_JWT_SECRET=
EA_JWT_EXPIRE_MINUTES=30
# Public fictional password, used only for seed data.
EA_DEMO_PASSWORD=DemoOnly!2026

# Explicit local model preparation and document indexing are required.
# A relative model path resolves from the D-drive project root.
EA_RAG_ENABLED=false
EA_RAG_MODEL_DIR=var/models
EA_RAG_MODEL_THREADS=2
EA_CHROMA_HOST=127.0.0.1
EA_CHROMA_PORT=58000
# Finite SDK connect/read/write/pool timeouts, range 0.1..30 seconds.
EA_CHROMA_TIMEOUT_SECONDS=10
EA_RAG_COLLECTION_PREFIX=ea_knowledge
# Character budgets, not model Token counts; 0 <= overlap < chunk_size.
EA_RAG_CHUNK_SIZE=500
EA_RAG_CHUNK_OVERLAP=80
EA_RAG_TIMEOUT_SECONDS=120
EA_RAG_UPLOAD_MAX_BYTES=8388608
EA_RAG_MAX_CHUNKS=1000
# Relevance heuristics; they do not prove semantic answer sufficiency.
EA_RAG_MIN_VECTOR_SIMILARITY=0.45
# The reranker returns sigmoid(logit) in 0..1, not a calibrated probability.
EA_RAG_MIN_RERANK_SCORE=0.05

# Direct knowledge search needs no chat API key. Agent execution requires one.
# Keep false until your own key is configured locally; no key belongs in Git.
EA_LLM_ENABLED=false
EA_DEEPSEEK_BASE_URL=https://api.deepseek.com
EA_DEEPSEEK_API_KEY=
EA_DEEPSEEK_MODEL=deepseek-flash
# Chat requests explicitly use thinking.type=disabled and non-streaming mode.
# Named choice: routing/rewrite/quote/SQL-plan controls; business tools auto.
EA_AGENT_ENABLED=true
EA_AGENT_MODEL_TIMEOUT_SECONDS=30
EA_AGENT_MODEL_MAX_TOKENS=1024
EA_AGENT_TIMEOUT_SECONDS=90
EA_AGENT_MAX_STEPS=24
EA_AGENT_MAX_TOOL_CALLS=8
EA_AGENT_MAX_RETRIES=2
# Message count, not number of conversation turns; complete Q/A pairs retained.
EA_AGENT_MAX_HISTORY_MESSAGES=12

# MCP is a separate, read-only stdio process and does not read .env.
# The client/server need ordinary DB/JWT/RAG settings in their process environment.
# Prefer scripts/mcp-demo.ps1 for local demo login and the configuration allowlist.
# For an existing JWT, set EA_MCP_ACCESS_TOKEN only in the invoking process environment.
# No access token should be stored here, passed as a CLI argument or printed.
EA_MCP_ACCESS_TOKEN=
# Per-call authentication + business-query budget, range 1..120 seconds.
EA_MCP_REQUEST_TIMEOUT_SECONDS=15
