# Phase 1: copy to .env; never commit .env.
EA_APP_ENV=development
EA_HOST=127.0.0.1
EA_PORT=8000
EA_LOG_LEVEL=INFO
EA_DOCS_ENABLED=true
EA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
EA_DATA_DIR=var

# Reserved for later phases; Phase 1 does not connect to these services.
EA_DATABASE_URL=
EA_REDIS_URL=
EA_LLM_ENABLED=false
EA_DEEPSEEK_BASE_URL=https://api.deepseek.com
EA_DEEPSEEK_API_KEY=
